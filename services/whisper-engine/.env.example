# Whisper model
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

# Pyannote diarization (accept license at huggingface.co/pyannote/speaker-diarization-3.1)
HF_TOKEN=your_huggingface_token_here
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_ENABLED=true

# Phase 2 — training data threshold before fine-tuning
MIN_TRAINING_HOURS=5
TRAIN_VAL_SPLIT=0.9

# Fine-tuning (World 2 — local GPU)
WHISPER_BASE_MODEL=openai/whisper-large-v3-turbo

# Deploy gate — max WER increase allowed vs baseline (0.02 = 2%)
MAX_WER_REGRESSION=0.02
MIN_DOMAIN_TERM_GAIN=0.0

# API
API_HOST=0.0.0.0
API_PORT=8000
